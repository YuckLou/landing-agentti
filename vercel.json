{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/planos", "destination": "/#planos", "permanent": true },
    { "source": "/login", "destination": "https://app.agentti.ia.br/?login=1", "permanent": false },
    { "source": "/entrar", "destination": "https://app.agentti.ia.br/?login=1", "permanent": false },
    { "source": "/cadastro", "destination": "https://app.agentti.ia.br/?register=1", "permanent": false },
    { "source": "/app", "destination": "https://app.agentti.ia.br/app", "permanent": false },
    { "source": "/app/:path*", "destination": "https://app.agentti.ia.br/app/:path*", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    }
  ]
}
